NODE_ENV=development
HOST=127.0.0.1
PORT=8000
APP_ORIGIN=http://localhost:8000
APP_BASE_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=votion
DB_USER=votion
DB_PASSWORD=replace-with-a-long-random-database-password
DB_TLS=false

# Optional JSON array of free STUN/TURN servers; defaults to a public STUN server.
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"}]
# WEBRTC_ICE_SERVERS='[{"urls":"turn:relay.example.com:3478","username":"short-lived-user","credential":"short-lived-password"}]'

INITIAL_ADMIN_NAME=Workspace Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Set these only when connecting a read-only Proxmox API token.
# PROXMOX_URL=https://proxmox.example.com:8006
# PROXMOX_TOKEN_ID=monitor@pve!employee-hub
# PROXMOX_TOKEN_SECRET=replace-with-the-token-secret

# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
# TRUST_PROXY=false
